{
  "name": "erin-math-lab",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.js --source",
    "start": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/production/*.test.js",
    "test:browser": "node tests/production/browser.cjs && node tests/production/upgrade.cjs && node tests/production/cancellation.cjs",
    "package": "node scripts/package.js",
    "test:pwa": "node tests/production/pwa.cjs",
    "format:check": "prettier --check src scripts tests/production index.html production.css",
    "audit:public": "node scripts/audit-public.js",
    "verify:dist": "node scripts/verify-dist.js"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
